# Локальные значения для разработки. Скопируйте в .env.local и запустите npm run db:init.
# Пароли ниже не для публичного сервера.

ADMIN_DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/postgres
DATABASE_URL=postgres://norma_app:change-me-local-only@127.0.0.1:5432/norma
APP_DB_PASSWORD=change-me-local-only
JWT_SECRET=replace-with-a-random-string-at-least-32-chars
APP_ORIGIN=http://127.0.0.1:38471

# Облако: Supabase + Vercel. Тогда замените строки выше, локальный PostgreSQL не нужен.
# ADMIN_DATABASE_URL — в Supabase кнопка Connect → Session pooler, порт 5432.
# Пользователь в этой строке: postgres.КОДПРОЕКТА. Пароль — пароль базы Supabase.
# APP_DB_PASSWORD — отдельный пароль роли приложения, без символов @ # ? &
# DATABASE_URL скрипт db:init напечатает сам: роль norma_app.КОДПРОЕКТА и порт 6543.
# На Vercel задайте DATABASE_URL, JWT_SECRET и APP_ORIGIN=https://ваш-проект.vercel.app
# ADMIN_DATABASE_URL на Vercel не нужен.
